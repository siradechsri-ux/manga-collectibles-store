POSTGRES_USER=manga
POSTGRES_PASSWORD=manga_dev_password
POSTGRES_DB=manga_store
POSTGRES_PORT=5432
DATABASE_URL=postgresql://manga:manga_dev_password@localhost:5432/manga_store?schema=public
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Enable the isolated browser-persisted prototype; no Express server or database is used.
NEXT_PUBLIC_USE_MOCK=true
AUTH_ACCESS_TOKEN_SECRET=local-development-only-secret-change-before-deploy-123456
AUTH_JWT_ISSUER=manga-store
AUTH_JWT_AUDIENCE=manga-store-web

# Set the real shop PromptPay ID to generate scannable payment QR codes.
PROMPTPAY_ID=
# Staging only: fake slip verification must never be enabled in production.
MOCK_SLIP_VERIFY=true
SLIP_VERIFICATION_ENDPOINT=
SLIP_VERIFICATION_API_KEY=
SLIP_VERIFICATION_PROVIDER=
