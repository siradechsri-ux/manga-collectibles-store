generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  FINANCE
  ADMIN

  @@map("user_role")
}

enum ShippingCarrier {
  FLASH
  THAI_POST

  @@map("ShippingCarrier")
}

enum PreorderReleaseStatus {
  OnSchedule
  Delayed
  Arrived

  @@map("PreorderReleaseStatus")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(150)
  phoneNumber  String?  @map("phone_number") @db.VarChar(20)
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lineUserId   String?  @map("line_user_id") @db.VarChar(100)

  @@map("users")
}

model Publisher {
  id        BigInt       @id @default(autoincrement())
  name      String       @unique @db.VarChar(200)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  series    MangaSeries[]
  products  Product[]

  @@map("publishers")
}

model MangaSeries {
  id          BigInt    @id @default(autoincrement())
  title       String    @db.VarChar(250)
  slug        String    @unique @db.VarChar(280)
  publisherId BigInt    @map("publisher_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  products    Product[]

  @@map("manga_series")
}

model Product {
  id          BigInt    @id @default(autoincrement())
  slug        String    @unique @db.VarChar(300)
  name        String    @db.VarChar(300)
  productType String    @map("product_type") @db.VarChar(20)
  volumeNumber Int?     @map("volume_number")
  publisherId BigInt?   @map("publisher_id")
  seriesId    BigInt?   @map("series_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  series      MangaSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  figure      FigureMetadata?

  @@map("products")
}

model ProductVariant {
  id                 BigInt    @id @default(autoincrement())
  productId          BigInt    @map("product_id")
  optionName         String    @map("option_name") @db.VarChar(150)
  sku                String?   @unique @db.VarChar(100)
  price              Decimal   @db.Decimal(12, 2)
  stockQuantity      Int       @default(0) @map("stock_quantity")
  weightGrams        Decimal?  @map("weight_grams") @db.Decimal(10, 2)
  availabilityStatus String    @default("IN_STOCK") @map("availability_status") @db.VarChar(24)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  preorder           Preorder?

  @@unique([productId, optionName])
  @@map("product_variants")
}

model Preorder {
  productVariantId BigInt                @id @map("product_variant_id")
  startDate        DateTime              @map("start_date") @db.Timestamptz(6)
  endDate          DateTime              @map("end_date") @db.Timestamptz(6)
  quotaLimit       BigInt?               @map("quota_limit")
  bookedCount      BigInt                @default(0) @map("booked_count")
  status           String                @default("PREORDER_OPEN") @db.VarChar(24)
  allowDeposit     Boolean               @default(false) @map("allow_deposit")
  depositAmount    Decimal?              @map("deposit_amount") @db.Decimal(12, 2)
  fullPrice        Decimal               @map("full_price") @db.Decimal(12, 2)
  preorderDeadline DateTime?             @map("preorder_deadline") @db.Timestamptz(6)
  releaseDate      DateTime?             @map("release_date") @db.Timestamptz(6)
  releaseMonthYear String?               @map("release_month_year") @db.VarChar(7)
  releaseStatus    PreorderReleaseStatus @default(OnSchedule) @map("release_status")
  productVariant   ProductVariant        @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@map("preorders")
}

model Manufacturer {
  id         BigInt           @id @default(autoincrement())
  name       String           @unique @db.VarChar(200)
  country    String?          @db.VarChar(100)
  websiteUrl String?          @map("website_url")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  figures    FigureMetadata[]

  @@map("manufacturers")
}

model Character {
  id         BigInt           @id @default(autoincrement())
  name       String           @db.VarChar(200)
  seriesName String           @map("series_name") @db.VarChar(250)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  figures    FigureMetadata[]

  @@unique([name, seriesName])
  @@map("characters")
}

model FigureMetadata {
  productId        BigInt       @id @map("product_id")
  manufacturerId   BigInt       @map("manufacturer_id")
  characterId      BigInt?      @map("character_id")
  scale            String       @db.VarChar(100)
  heightMm         Int?         @map("height_mm")
  material         String?      @db.VarChar(200)
  sculptor         String?      @db.VarChar(200)
  janCode          String?      @map("jan_code") @db.VarChar(13)
  boxWidthCm       Decimal?     @map("box_width_cm") @db.Decimal(8, 2)
  boxLengthCm      Decimal?     @map("box_length_cm") @db.Decimal(8, 2)
  boxHeightCm      Decimal?     @map("box_height_cm") @db.Decimal(8, 2)
  actualWeightKg   Decimal?     @map("actual_weight_kg") @db.Decimal(9, 3)
  warehouseStatus  String       @default("NOT_ARRIVED") @map("warehouse_status") @db.VarChar(32)
  arrivedAt        DateTime?    @map("arrived_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  manufacturer     Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  character        Character?   @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@map("figures_metadata")
}

model ShippingRate {
  id                    BigInt          @id @default(autoincrement())
  carrier               ShippingCarrier
  serviceAreaCode       String          @map("service_area_code") @db.VarChar(50)
  minBillableWeightKg   Decimal         @default(0) @map("min_billable_weight_kg") @db.Decimal(9, 3)
  maxBillableWeightKg   Decimal?        @map("max_billable_weight_kg") @db.Decimal(9, 3)
  shippingFee           Decimal         @map("shipping_fee") @db.Decimal(12, 2)
  effectiveFrom         DateTime        @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveUntil        DateTime?       @map("effective_until") @db.Timestamptz(6)
  isActive              Boolean         @default(true) @map("is_active")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("shipping_rates")
}
